# Blooket login
# There are no Blooket credentials here: an admin logs in by hand once in the
# publishing browser window and the persistent profile keeps the session.
# Profile directory (default: <cwd>/playwright-profile)
BLOOKET_PROFILE_DIR=
# Session state file directory (default: <cwd>/.tmp/state)
STATE_DIR=
# Wait for a manual login inside a publish job (default: true outside production).
# In production an expired session pauses publishing instead.
BLOOKET_INTERACTIVE_LOGIN=
# Hours between background session checks (default: 12 in production, off in dev)
SESSION_CHECK_HOURS=
# websockify/noVNC address for the /admin remote browser view (server only, e.g. http://127.0.0.1:6080)
VNC_UPSTREAM=

# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Security & Admin
# Required for /admin; production refuses to start unless it is >= 16 characters
ADMIN_PASSWORD=
# Cloudflare Turnstile: required in production (server refuses to start without it).
# Leave both empty locally to skip human verification.
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

# Per-IP daily limits
RATE_LIMIT_GENERATE_PER_DAY=30
RATE_LIMIT_REFINE_PER_DAY=60
RATE_LIMIT_PUBLISH_PER_DAY=10

# Admin alerts via Telegram (optional; without them alerts only go to the log)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public site URL, used for the /admin link in alerts (e.g. https://quizgen.duckdns.org)
PUBLIC_URL=

# Server
# Public hostname for HTTPS (production / docker-compose only), e.g. quizgen.duckdns.org
DOMAIN=
PORT=3001
NODE_ENV=development
# true when running behind a reverse proxy (Caddy) so client IPs are real
TRUST_PROXY=false
# Built web app served by the API (default: ../web/dist next to the server)
WEB_DIST_DIR=

# Optional: writable directory for temp CSV uploads and anonymous check profiles
# (defaults to the OS temp dir)
BLOOKET_TMP_DIR=
