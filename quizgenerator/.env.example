# Blooket login
# There are no Blooket credentials here: an admin logs in by hand once in the
# publishing browser window and the persistent profile keeps the session.
# Profile directory (default: <cwd>/playwright-profile)
BLOOKET_PROFILE_DIR=
# Session state file directory (default: <cwd>/.tmp/state)
STATE_DIR=
# Wait for a manual login inside a publish job (default: true outside production).
# In production an expired session pauses publishing instead.
BLOOKET_INTERACTIVE_LOGIN=

# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Security & Admin
# Required for /admin; production refuses to start unless it is >= 16 characters
ADMIN_PASSWORD=
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

# Server
PORT=3001
NODE_ENV=development

# Optional: writable directory for temp CSV uploads and anonymous check profiles
# (defaults to the OS temp dir)
BLOOKET_TMP_DIR=
