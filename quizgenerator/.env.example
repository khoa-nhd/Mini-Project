# Blooket Credentials
BLOOKET_USERNAME=
BLOOKET_PASSWORD=
# Or provide Blooket session cookie directly (recommended to avoid captcha)
BLOOKET_COOKIE=

# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Security & Admin
ADMIN_PASSWORD=change-this-in-production
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

# Server
PORT=3001
NODE_ENV=development

# Optional: writable directory for temp CSV uploads and anonymous check profiles
# (defaults to the OS temp dir)
BLOOKET_TMP_DIR=
